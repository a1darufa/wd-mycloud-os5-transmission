# Sources for the Transmission payload, compiled into static ARM binaries
# (transmission4/assemble-payload.sh). fetch.sh downloads them and refuses any
# file whose checksums differ from these.
#
# Transmission: the release tarball from the official repository
# (github.com/transmission/transmission/releases). SHA256 as published by
# GitHub for the release asset; SHA512 as pinned independently in Alpine's
# recipe (aports community/transmission), which builds the same file unpatched.
TRANSMISSION_VERSION=4.1.4
TRANSMISSION_URL=https://github.com/transmission/transmission/releases/download/4.1.4/transmission-4.1.4.tar.xz
TRANSMISSION_SHA256=86e7aa020cdf64826447034bc85f4d3b7c848d8c0891d9dc9b9fddfb2c805d22
TRANSMISSION_SHA512=673c7c86ce6875c2b4b472126ace66710d16a5927d28668105e1b72bf0902186c9d1dfbde3695ed9026a6e0c4c33bb1f4b88fdc43c2b7edf7f14ac177f1f27c0

# su-exec: starts the daemon as nobody:share (BusyBox on the NAS has no su).
# Tag tarball from its upstream repository; SHA512 as pinned in Alpine's
# recipe (aports main/su-exec).
SU_EXEC_VERSION=0.3
SU_EXEC_URL=https://github.com/ncopa/su-exec/archive/v0.3.tar.gz
SU_EXEC_SHA512=2fe42ca1696de3b54c684e7a782aed4d6f5f97a430f6e4dae65b828c9f31c58fba7190d3f0755ef011fa4609d4bf97087d427d2a20768db5a54a6d15ee111104

# The ARM build environment is docker/alpine/Dockerfile. Its exact package
# set, including the static libraries linked into the binaries, is pinned in
# transmission4/packages.lock.
